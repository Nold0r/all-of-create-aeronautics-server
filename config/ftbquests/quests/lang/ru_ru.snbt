	quest.2109B036CB2EB0D6.title: "Получите или изготовьте блок магмы"
	quest.210E4B306AAF4FD5.quest_desc: ["Собери &eспидометр&r и &eстрессометр.&r Они помогают увидеть &6скорость вращения&r и &cнагрузку сети&r."]
