	quest.1FDD59715B5DB47D.quest_desc: ["Создай &eконтроллер реактора&r."]
	quest.1FDD59715B5DB47D.quest_subtitle: "Управление реактором"
	quest.1FDD59715B5DB47D.title: "Контроллер"
	quest.1FDEB8120A9E8025.quest_desc: ["Запомни роль механизма синхронизации: позже он войдёт в контроллер реактора вместе со звездой Нижнего мира."]
	quest.1FDEB8120A9E8025.quest_subtitle: "Цель на потом"
	quest.1FDEB8120A9E8025.title: "Синхронизация контроллера"
	quest.1FE8EA6FB9329269.quest_desc: [
		"&b&lEcho Shard&r — это первый шаг на пути к созданию очень мощного &5оружия и &5брони&r, которое предоставляет Deep Dark&r."
		""
		"&l-&r Хотя обычно его можно найти только в сундуках с добычей внутри &2Древнего города&r, после многих проб и ошибок некоторые &6Мастеры-клерики&r смогли синтезировать его, не выходя из собственных пивоваренных стендов, что позволяет вам избежать многих опасностей внутри этих городов."
	]
	quest.1FE8EA6FB9329269.title: "&bЭхо Осколок"
	quest.1FFF9B91CA71694E.quest_subtitle: "Лава наносит небольшое количество урона от огня существам, находящимся ниже в радиусе."
	quest.1FFF9B91CA71694E.title: "&cВедро с лавой"
	quest.2005366DA716D1AA.quest_desc: [
		"Самая длинная часть нашего процесса - преобразование &6слитка незерита&r в &3&lЭхо-слиток&r требует от нас повторения пятиэтапного процесса"
		""
		"1&l-&r Полить его &cлавой&r"
		"2&l-&r Нажатие"
		"3&l-&r Наливаем на него немного &dMolten Echo&r"
		"4&l-&r Нанесение на нее порошка &eBlaze&r"
		"5&l-&r А затем снова нажать"
		""
		"&c&nПять раз больше&r&r"
		""
		"Но в конце этого изнурительного процесса мы станем обладателями первозданного состояния &3&lЭхо-слитка&r"
	]
	quest.2005366DA716D1AA.title: "&l&9Эхо-слиток"
	quest.2047D5978329D0AB.title: "Тыква"
	quest.20972F17140B6E7B.quest_subtitle: "Булыжник2"
