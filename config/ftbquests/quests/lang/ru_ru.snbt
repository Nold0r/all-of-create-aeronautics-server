	]
	quest.1B86EC358F46598A.quest_subtitle: "Ближний бой"
	quest.1B86EC358F46598A.title: "Дробовик"
	quest.1BAE590C1F42160D.quest_subtitle: "Нажмите &c\"Z\"&r Чтобы узнать, как его построить."
	quest.1BAE590C1F42160D.title: "Построить дистилляционную башню"
