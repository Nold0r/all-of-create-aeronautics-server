# NeoForge-generated runtime files. start-server scripts restore them when needed.


# Client-only files are not needed on a dedicated server.
/client-mods-excluded/

# Disabled duplicate mod copies and temporary files
*.duplicate
*.tmp
*.bak

# Local secrets and editor/OS metadata
.env
.env.*
.DS_Store
Thumbs.db
/.idea/
/.vscode/
