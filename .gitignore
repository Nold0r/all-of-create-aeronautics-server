# Minecraft worlds and automatic backups
/world/
/world_*/
/backups/

# Runtime state
/logs/
/crash-reports/
/cache/
/dynamic-data-pack-cache/
/local/
/.mixin.out/
/.pg-native/
/.sable/
/hs_err_pid*.log
/*.log

# Player and access-control state (keep only on the server)
/usercache.json
/usernamecache.json
/banned-ips.json
/banned-players.json
